# Projet Supabase « Mtconseil - App » (ca-central-1) = DEV
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Phase 2 — lecture de plaques (Claude vision). Server-only (JAMAIS NEXT_PUBLIC_*).
ANTHROPIC_API_KEY=sk-ant-xxx

# Garde-fou Loi 25. Ne mettre à true que pour tester avec des données anonymisées/synthétiques,
# tant que Luis n'a pas donné son accord écrit.
ALLOW_PLAQUE_AI=false
ALLOW_FACTURE_AI=false
ALLOW_REDACTION_AI=false

# Phase 8 — notifications par courriel (Resend). Best-effort : sans clé, les transitions
# de statut réussissent quand même (l'échec est loggé). Server-only.
RESEND_API_KEY=re_xxx
COURRIEL_EXPEDITEUR="MT Conseil <audits@exemple.com>"   # domaine expéditeur vérifié dans Resend
NEXT_PUBLIC_SITE_URL=https://app.exemple.com             # base des liens dans les courriels

# Phase 12 — conversion docx→PDF + fusion de l'annexe Optima (Gotenberg auto-hébergé).
# Déployer gotenberg/gotenberg:8 en région Canada (Loi 25 : données au Canada). Sans cette
# variable, l'export PDF renvoie 503. Local : docker run -p 3000:3000 gotenberg/gotenberg:8
GOTENBERG_URL=http://localhost:3000
